# Supabase — from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# App URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth — same Client ID/Secret you pasted into Supabase Auth > Google provider
# Needed for server-side Gmail API token refresh
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# Anthropic Claude API — for AI summaries and reply generation
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# Optional: override the model used for AI features (defaults to claude-haiku-4-5-20251001)
# CLAUDE_MODEL=claude-haiku-4-5-20251001
